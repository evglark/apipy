# Application
DATABASE_URL=postgresql+asyncpg://apipy:apipy@localhost:5432/apipy

# JWT/Auth
JWT_ALGORITHM=HS256
API_SECRET_KEY=replace-with-strong-random-secret
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=apipy
JWT_AUDIENCE=apipy-clients

# Token lifetime (seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# Login/rate-limit
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=60
IP_RATE_LIMIT_ATTEMPTS=20
IP_RATE_LIMIT_WINDOW_SECONDS=60
